# Copy to backend/.env and fill in. Everything here is optional for running on your laptop.

# Gemini powers the AI agents (Availability, Scheduling, Needs, Swap rationale, Explainer).
# Without a key, agents use built-in logic and the app still works end to end.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite

# Change this before sharing the app beyond your laptop (signs login tokens).
CAMPUSSYNC_SECRET=change-me-to-a-long-random-string

# 1 = /demo control room enabled. With CAMPUSSYNC_ADMIN_KEY set, resetting needs that key.
CAMPUSSYNC_DEMO=1
CAMPUSSYNC_ADMIN_KEY=

# Database. Empty = local SQLite file (backend/campussync.db). Render sets DATABASE_URL for Postgres.
DATABASE_URL=

# Default time zone (each employer can set its own in Settings).
CAMPUSSYNC_TZ=America/New_York

# ---- Google Calendar (optional) — docs/GOOGLE_CALENDAR.md ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CAMPUSSYNC_PUBLIC_URL=http://localhost:8000

# ---- Phone notifications (Web Push) ----
# Leave empty: keys are generated once and stored in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@campussync.app

# Autopilot loop interval in seconds (0 = off). Alerts and time reporting run in this loop.
CAMPUSSYNC_AUTOPILOT_SECONDS=15
